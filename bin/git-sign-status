# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

git_sign_status() {
  local alertment=""

  if test -n "$(git config get user.signingkey)"; then
    alertment="🤝 GPG Signing engaged! 🖋️ 📜"
  else
    alertment="🚫 GPG Signing disengaged 🥸"
  fi

  echo "*** ${alertment}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

main() {
  git_sign_status "$@"
}

if [ "$0" = "${BASH_SOURCE[0]}" ]; then
  main "$@"
fi
