#!/usr/bin/env bash
# vim:tw=0:ts=2:sw=2:et:norl:ft=bash
# Author: Landon Bouma (landonb &#x40; retrosoft &#x2E; com)
# Project: https://github.com/landonb/git-smart#💡
# License: MIT. Please find more in the LICENSE file.

# USAGE: git reword {commit}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# USYNC: See tig-newtons command:
#   rebase_reword________selected_rev_________
# https://github.com/DepoXy/tig-newtons#🍎
# CXREF: If using DepoXy, it's at:
#   ~/.kit/git/tig-newtons/tig/bind-rebase

git_reword_revision () {
  local commit="$1"

  set -e

  if ! git diff --cached --quiet; then
    >&2 echo "ERROR: git-reword disabled while staging"

    return 1
  fi

  local wipped=false

  git add -A \
    && git commit --no-verify -m "${GITSMART_GIT_REWORD_WIP_COMMIT_MESSAGE}" > /dev/null \
    && wipped=true

  maybe_unstash_changes () {
    if ${wipped} \
      && test "$(git log -1 --format=%s)" = "${GITSMART_GIT_REWORD_WIP_COMMIT_MESSAGE}" \
    ; then
      git reset --quiet --mixed @~1
    fi
  }

  GIT_SEQUENCE_EDITOR='f () { \
    local rebase_todo_path="$1"

    sed -i "1 s/^pick/reword/" "${rebase_todo_path}"
  }; f "$1"' git rebase -i "${commit}"^

  # We assume the rebase won't fail, because user is only rewording a message.

  # Run any post-rebase user hooks.
  if [ -n "${GIT_POST_REBASE_EXEC}" ]; then
    eval ${GIT_POST_REBASE_EXEC}
  fi

  maybe_unstash_changes
}

GITSMART_GIT_REWORD_WIP_COMMIT_MESSAGE="${PRIVATE_PREFIX:-PRIVATE: }WIP [git-reword]"

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

main () {
  git_reword_revision "$@"
}

if [ "$0" = "${BASH_SOURCE[0]}" ]; then
  main "${@}"
fi

