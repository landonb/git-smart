# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

show_usage() {
  echo "NAME"
  echo "    git-initci - init + commit --allow-empty"
  echo
  echo "SYNOPSIS"
  echo "    git initci [git-init   options: -b <branch-name> | --initial-branch=<branch-name> -- *only*]"
  echo "               [git-commit options: -m, -F, -e, --no-verify, -S, et al. -- *all options usable*]"
  echo
  echo "Initialize new Git repo (if necessary) and then git-commit an empty commit."
  echo "- Like normal commit, opens EDITOR so you can draft a striking root commit"
  echo "  message, unless you use a commit message option (-m/-c/-C/-F)."
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Note this only honors a single git-init option, -b|--initial-branch,
# and it must be the first argument.
# - This lets us pass the remaining args to git-commit, which is much
#   more useful to the user than having more git-init args.
# - From the git-init options, you can tell that nothing is "missing"
#   from the git-initci command:
#   - From man git-init:
#     -q, --quiet
#     --bare
#     --object-format=<format>
#     --ref-format=<format>
#     --template=<template-directory>
#     --separate-git-dir=<git-dir>
#     -b <branch-name>, --initial-branch=<branch-name>
#     --shared[=(false|true|umask|group|all|world|everybody|<perm>)]

git_initci() {
  local branch_cmd=""
  local branch_name=""

  # FIXME- FTREQ: Add man. Until then, --help fails; but -h works.
  if test "$1" = "-h" || test "$1" = "--help"; then
    show_usage

    exit 0
  elif test "$1" = "-b"; then
    branch_cmd="$1"
    branch_name="$2"

    if ! shift 2 || test -z "${branch_name}"; then
      # Altly: Use format other than the normal Git-branch error:
      #   >&2 echo "ERROR: Missing <branch-name>"
      >&2 echo "fatal: invalid initial branch name: '${branch_name}'"

      exit 1
    fi
  elif echo "$1" | grep -q -e "^--initial-branch="; then
    branch_cmd="$1"

    shift
  fi

  # ***

  # The working dir. might be subdirectory of an existing Git project.
  # - In which case, run `git init .` to create a new Git repo.
  #
  # ... but first! ensure the actual working directory is "correct".
  #
  # SAVVY: Unlike a ~/.gitconfig alias, git-commands on PATH
  # are run from the current working directory, not from the
  # project root — and GIT_PREFIX is unset. /#interEST
  # - Same thing if you wire an alias directly to the command.
  #   - For example, this alias runs git-initci from user's
  #     current working directory, and it leaves GIT_PREFIX
  #     unset:
  #       # ~/.gitconfig
  #       initci-alias = initci
  # - BWARE: But when called as git-command from an alias,
  #   then GIT_PREFIX is inherited from the alias.
  #   - For example, this runs from project root and sets
  #     GIT_PREFIX to relative path to user's working dir:
  #       # ~/.gitconfig
  #       initci-alias = "! f() { git ciinit \"$@\"; }; f"
  # - SAVVY: Therefore when calling `git initci` from alias,
  #   change the directory and clear the environ first.
  #   - For example:
  #       cd -- \"${GIT_PREFIX:-.}\"; \
  #       unset -v GIT_PREFIX; \
  #   - But in case alias calls git-initci without doing so,
  #     we'll assume if GIT_PREFIX set, that we need to cd
  #     *back* to the working directory from within which
  #     the user is actually running the initci command. ദി
  cd -- "${GIT_PREFIX:-.}"

  local inited=false

  git_init_maybe

  must_verify_empty_branch

  git_sign_status

  git_commit_empty "$@"
}

# ***

is_git_repo_root() {
  rel_root="$(git rev-parse --show-cdup 2>/dev/null)" &&
    test -z "${rel_root}" || false
}

# ***

git_init_maybe() {
  if is_git_repo_root; then
    if [ -n "${branch_cmd}" ]; then
      >&2 echo "BWARN: Ignoring branch-name because repo already exists"
    fi

    return
  fi

  inited=true

  # Prints, e.g.:
  #   Initialized empty Git repository in /path/.git/
  # Or stops on errexit, e.g.:
  #   $ git initci -b '.' .
  #   fatal: invalid initial branch name: '.'
  command git init ${branch_cmd} ${branch_name} .

  # Print double-wavy underscores under the new .git/ path that git-init prints.
  echo "*** I inited that 4 U! ༼ つ ◔_◔ ༽つ" \
    "$(
      echo "$(pwd -P)/.git/" | perl -pe 's/^(.+?)$/"﹌" x int((length($1) + 1) \/ 2)/e'
    )"
}

# ***

# We insist that the repo has no commits and no branches.
#
# - Generally, the user will run initci after creating a new
#   repository. But you might also run it on an empty branch.
#
#   - E.g., you can use --orphan to create a root-less branch:
#
#       git checkout --orphan start-from-scratch
#       git reset
#       # (Mostly) Equivalent to:
#       #   git commit --allow-empty -m "root commit message"
#       git initci -m "root commit message"
#
# Note this does not insist that the repo is entirely empty, e.g.:
#
#   git rev-list --count --all 2>/dev/null
#
# - but we limit the check to just HEAD.
#
# And really we don't need to insist there are no commits — this
# command runs just fine regardless — but we make this check just
# because the *intent* of the git-initci command is for creating
# a very first, empty root commit
# - [And IIRC, the author created this command instead of
#    remembering about --allow-empty; also because I like to
#    memorialize common workflows, regardless of complexity.
#    - E.g., I starting use `ll` in my shell because `ls -la`
#     was *sooooo* difficult. =]
#
# SAVVY: Note that --all prints 0 on empty repo; HEAD prints nothing:
#   $ command rm -rf .git/ &&
#     command git init &&
#     echo "--all: $(git rev-list --count --all 2>/dev/null)" &&
#     echo " HEAD: $(git rev-list --count HEAD 2>/dev/null)"
#   --all: 0
#    HEAD:

must_verify_empty_branch() {
  if test -n "$(git rev-list --count HEAD 2>/dev/null)"; then
    >&2 echo "ERROR: What's the point? There is already a root commit! 🫜"

    exit 1
  elif ! ${inited}; then
    echo "*** Congrats, this is the very first commit 🏆 (•̀ᴗ•́)و"
  fi

  # Earlier git_init_maybe ensures local git/.
  if ! test -d ".git"; then
    >&2 echo "GAFFE: Missing local .git/ dir?!"

    exit 1
  fi

  # Too strict: git status --porcelain=v1
  if ! git diff --cached --quiet; then
    >&2 echo "ERROR: Please git-reset or otherwise clear the index"

    exit 1
  fi
}

# ***

git_sign_status() {
  git sign-status

  echo "- Run \`git sign-help\` for more 🙋"
}

# ***

git_commit_empty() {
  local gpg_sign=""

  if test -n "$(git config get user.signingkey)"; then
    gpg_sign="-S"
  fi

  git commit --allow-empty ${gpg_sign} "$@"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

main() {
  set -e

  git_initci "$@"
}

if [ "$0" = "${BASH_SOURCE[0]}" ]; then
  main "$@"
fi
