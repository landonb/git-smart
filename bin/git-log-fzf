#!/usr/bin/env bash
# vim:tw=0:ts=2:sw=2:et:norl:ft=bash
# Author: Various.
# Project: https://github.com/landonb/git-smart#💡

# http://owen.cymru/fzf-ripgrep-navigate-with-bash-faster-than-ever-before/
# "It will let you select a commit, and display the diff off it, and put the
# commit hash on your clipboard using xclip. I also have it set to use icdiff via
# `git showtool`."

fzf_log() {
  hash=$(git log --color=always --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" "$@" | fzf | awk '{print $1}')
  printf "%s" $hash | _gsm_clip_raw
  git showtool $hash
}

# COPYD/2025-09-10: See `_hf_clip_raw` in Homefries:
# https://github.com/landonb/home-fries#🍟
_gsm_clip_raw() {
  if command -v pbcopy >/dev/null; then
    pbcopy
  elif [ -n ${WAYLAND_DISPLAY} ] && command -v wl-copy >/dev/null; then
    wl-copy
  elif [ -n ${DISPLAY} ] && command -v xclip >/dev/null; then
    xclip -selection c
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

main() {
  fzf_log
}

if [ "$0" = "${BASH_SOURCE[0]}" ]; then
  main "${@}"
fi
